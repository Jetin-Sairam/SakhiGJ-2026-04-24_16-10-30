  m_Script: {fileID: 11500000, guid: c6c18cbd4468ade4f91e2efbeb8ea540, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InventoryManager
  itemDatabase:
  - name: Fathers Room Key
    icon: {fileID: 21300000, guid: fbf60069cc2fe3741a2d6bdc49869901, type: 3}
    description: 
  - name: Letter
    icon: {fileID: -4181906289457810447, guid: 48dfbf43e9f7edc4386aa39f73bb4e33, type: 3}
    description: "To \nMy dear daughter,\nI never thought this would be our last
      conversation. I always imagined that my last breath would be taken while playing
      with my grandson and granddaughter. Unfortunately, every story has an end,
      and this letter is the end of mine. I hope that by the time you read this,
      my soul will have left my body.\n\nI hope you remember those days when your
      little one used to play all day in the garden. Now, let that garden be what
      helps you move forward in your life. It is hard to end this letter, but my
      hand can no longer move forward. I hope you understand.\nTake care, my girl.\nYours,\nDad"
  - name: Final Safe Key
    icon: {fileID: -2091691298951779074, guid: 4f839aa948c7c0c449339bf02574228e, type: 3}
    description: 
  inventoryItems: []
